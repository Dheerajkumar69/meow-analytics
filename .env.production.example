# ==============================================================================
# Meow Analytics — VM Production Environment Configuration
# ==============================================================================

# Node Environment
NODE_ENV=production

# Network Configuration
HOST=0.0.0.0
PORT=3001
PORT_HTTP=80

# Domain & SSL Configuration
# Set your public domain pointing to your VM (e.g., analytics.example.com)
DOMAIN=analytics.example.com
CADDY_EMAIL=admin@example.com

# Local PostgreSQL Database Credentials (used by Docker Compose)
POSTGRES_USER=meow
POSTGRES_PASSWORD=replace_with_a_secure_postgres_password
POSTGRES_DB=meow_analytics

# Database URL
# If using the included Docker PostgreSQL container:
DATABASE_URL=postgres://meow:replace_with_a_secure_postgres_password@postgres:5432/meow_analytics
# If using an external managed PostgreSQL (Neon, Supabase, AWS RDS, etc.):
# DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require
# DATABASE_SSL=true

# Cryptographic Secrets (REQUIRED)
# Generate with: openssl rand -hex 32
MEOW_SECRET=replace_with_at_least_32_hex_chars_openssl_rand_hex_32

# Admin Master Secret for Dashboard & API Authentication (REQUIRED)
# Generate with: openssl rand -hex 24
ADMIN_SECRET=replace_with_at_least_16_hex_chars_openssl_rand_hex_24

# Allowed CORS Origins (comma-separated list of sites or * for all)
CORS_ORIGINS=*

# Logging and Ingestion Performance
LOG_LEVEL=info
ASYNC_INGESTION=true
DATABASE_POOL_MAX=25
RATE_LIMIT_ENABLED=true
ENABLE_BACKGROUND_WORKERS=true
