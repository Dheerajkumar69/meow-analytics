# Node Environment (development | test | production)
NODE_ENV=development

# Server Port and Host
PORT=3001
HOST=0.0.0.0

# Database Connection URL
# For local Docker Compose:
DATABASE_URL=postgres://meow:meow_secret@localhost:5432/meow_analytics
# For zero-dependency in-memory testing/development:
# DATABASE_URL=memory://

# Meow Internal Secret (at least 32 characters)
MEOW_SECRET=meow_dev_secret_at_least_32_characters_long_for_security_123

# Admin Secret for Dashboard / Protected API Authentication (at least 16 characters)
ADMIN_SECRET=meow_admin_super_secret_key_12345
# Optional: Pre-authenticate dashboard in local development
# VITE_ADMIN_SECRET=meow_admin_super_secret_key_12345

# Allowed CORS Origins (comma-separated list, e.g., http://localhost:5173,http://localhost:3000)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Logging Level (debug | info | warn | error)
LOG_LEVEL=info
