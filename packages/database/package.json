{
  "name": "@meow-analytics/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "db:generate": "drizzle-kit generate:pg",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.14",
    "@meow-analytics/config": "*",
    "@meow-analytics/shared": "*",
    "@types/node": "^26.6.2",
    "drizzle-orm": "^0.30.10",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "@types/pg": "^8.11.4",
    "drizzle-kit": "^0.20.18",
    "tsx": "^4.7.1",
    "typescript": "^5.4.2"
  }
}
