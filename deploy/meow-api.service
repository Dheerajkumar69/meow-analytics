[Unit]
Description=Meow Analytics API Service
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=meow
Group=meow
WorkingDirectory=/opt/meow-analytics
EnvironmentFile=/opt/meow-analytics/.env
ExecStart=/usr/bin/node /opt/meow-analytics/apps/api/dist/server.js
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=meow-analytics
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
